# Copy this file to .env and fill in a key to enable real conversational AI
# in the Vayu Astra assistant. Without a key, the assistant still works —
# it just uses a canned offline reply for open-ended chat while all live
# route/index/forecast/anomaly/CPI data continues to work normally either way.

ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-4-5-20250929
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
